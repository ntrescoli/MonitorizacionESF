config/**/*.pyo

# Logs
config/*.log
config/*.log.*

# Base de datos
config/*.db
config/*.db-*
config/*.sqlite
config/*.sqlite-*

# Dependencias generadas
config/deps/

# TTS generado
config/tts/

# =========================================
# Secretos
# =========================================

config/secrets.yaml

# =========================================
# Docker
# =========================================

.env
.env.*
!.env.example